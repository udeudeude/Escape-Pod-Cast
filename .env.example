ADMIN_PASSWORD=choose-a-strong-password
FEED_TOKEN=replace-with-a-long-random-string
SHOW_TITLE=Escape Pod Cast
SHOW_DESCRIPTION=My personal audio feed.
AUTHOR=Personal
